NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

NEXT_PUBLIC_GA_ID=

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Shared-expense groups (server-only — never NEXT_PUBLIC_)
# Service-account JSON for money-tracker-46f60 (raw JSON or base64 of it)
FIREBASE_SERVICE_ACCOUNT=
# Adapty dashboard → App settings → Secret key (server-side Premium checks)
ADAPTY_SECRET_KEY=
# Shared secret configured in Adapty → Integrations → Webhook → Authorization header
ADAPTY_WEBHOOK_SECRET=

# Lumi messaging (push + email) — lib/server/messaging/
# Long random string; signs email unsubscribe links. Never change it once emails went out.
MESSAGING_SECRET=
# Key for /admin/messaging and /api/messaging/campaigns (24+ chars)
MESSAGING_ADMIN_KEY=
# Resend API key; EMAIL_FROM's domain must be verified in Resend
RESEND_API_KEY=
EMAIL_FROM="Lumi <hello@lumi.herman-apps.com>"
EMAIL_REPLY_TO=
# 1 = send triggered emails (welcome, pro_started, trial_cancelled)
MESSAGING_TRIGGERS_ENABLED=
# Vercel cron auth (Vercel sends it as a Bearer token)
CRON_SECRET=
# Only if Expo "Enhanced push security" is on
EXPO_ACCESS_TOKEN=
